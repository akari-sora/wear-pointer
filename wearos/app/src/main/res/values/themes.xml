<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Swipe-to-dismiss is off: the touchpad mode reads horizontal finger slides,
        and a slide from the left edge must not close the app. Leave with the
        watch's Back / Home key.
    -->
    <style name="Theme.WearPointer" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowSwipeToDismiss">false</item>
    </style>

    <!--
        Launch theme: the Wear OS branded launch, a 48dp app icon on black.
        MainActivity.installSplashScreen() swaps to Theme.WearPointer.
    -->
    <style name="Theme.WearPointer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen</item>
        <item name="postSplashScreenTheme">@style/Theme.WearPointer</item>
        <item name="android:windowSwipeToDismiss">false</item>
    </style>
</resources>
